{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs + Rust-side fetch to any hub URL",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "https://*:*/*" },
        { "url": "http://**" },
        { "url": "http://*:*/*" }
      ]
    }
  ]
}
