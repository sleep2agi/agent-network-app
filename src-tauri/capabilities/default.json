{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs + Rust-side fetch to any hub URL",
  "windows": ["main", "chat-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "process:allow-restart",
    "updater:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "https://*:*/*" },
        { "url": "http://**" },
        { "url": "http://*:*/*" }
      ]
    }
  ]
}
