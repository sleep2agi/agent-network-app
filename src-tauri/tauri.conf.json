{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Network",
  "version": "0.2.33-2",
  "identifier": "top.vansin.agentnetwork.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Network",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/commhub"],
    "resources": ["binaries/commhub-manifest.json"],
    "targets": ["app", "dmg"],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QkMwODAxQkMzQTJBQjkKUldTNUtqcThBUWk4TlNtZjB4L2hOLzRHQjdjNVlNOWMvSjVteGR5aVV5d2FJSENxRWIwUllxMEIK",
      "endpoints": [
        "https://anet.sh/desktop/update/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
