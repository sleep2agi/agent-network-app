# Optional local dependency cache, same source and commands as Dockerfile web.
# Authoritative empty-machine recipe is Dockerfile; this cache is not a release.
FROM anet-app:mobile-provider-entry-core AS web
WORKDIR /app
COPY . .
ENV CI=1 EXPO_NO_TELEMETRY=1
RUN npx --no-install expo export -p web --output-dir /web
FROM anet-app:create-provider905-final-browser AS browser
COPY --from=web /web /web
COPY tests/scoped-secrets/drive.mjs /app/tests/scoped-secrets/drive.mjs
CMD ["node","tests/scoped-secrets/drive.mjs"]
