# TEST-ONLY narrow visual regression; never a release artifact.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
RUN npm install --prefix /qa-tools --no-save --no-audit --no-fund esbuild@0.25.5
COPY . .
RUN npm run typecheck
RUN NODE_PATH=/qa-tools/node_modules node tests/user-avatar/build.cjs
FROM mcr.microsoft.com/playwright:v1.58.2-noble@sha256:6446946a1d9fd62d9ae501312a2d76a43ee688542b21622056a372959b65d63d
WORKDIR /app
RUN npm install --no-audit --no-fund --ignore-scripts playwright@1.58.2
COPY --from=build /app/user-avatar.js ./user-avatar.js
COPY tests/user-avatar/drive.mjs tests/user-avatar/drive.mjs
CMD ["node", "tests/user-avatar/drive.mjs"]
