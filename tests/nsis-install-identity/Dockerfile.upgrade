FROM node:22.23.0-bookworm@sha256:e0d149b4727ac0c20d9774e801e423d7a946a0bffced886f42cfe9cd3c67820a
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y --no-install-recommends nsis wine wine32 wine64 xvfb xauth node-handlebars ca-certificates curl
WORKDIR /fixture
ARG TAURI_COMMIT=499df79be65ef8c0670abc0207cd9e37b55d8491
RUN mkdir plugins && for name in installer.nsi utils.nsh FileAssociation.nsh languages/English.nsh; do curl -fsSL "https://raw.githubusercontent.com/tauri-apps/tauri/${TAURI_COMMIT}/crates/tauri-bundler/src/bundle/windows/nsis/${name}" -o "$(basename "$name")"; done && curl -fsSL https://github.com/tauri-apps/nsis-tauri-utils/releases/download/nsis_tauri_utils-v0.5.3/nsis_tauri_utils.dll -o plugins/nsis_tauri_utils.dll && echo '75197fee3c6a814fe035788d1c34ead39349b860  plugins/nsis_tauri_utils.dll' | sha1sum -c -
COPY src-tauri/windows/vendor/installer.tauri-2.11.2.nsi template.nsi
COPY tests/nsis-install-identity/upgrade.cjs ./
ENV WINEDEBUG=-all
# Run with docker --init: Xvfb's readiness signal must not target PID 1.
CMD ["xvfb-run", "-a", "node", "upgrade.cjs"]
